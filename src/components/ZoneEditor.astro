---
import VectorSquare from "@lucide/astro/icons/vector-square";
import Button from "./ui/Button.astro";
import FieldLabel from "./ui/FieldLabel.astro";
import TextField from "./ui/TextField.astro";
import ColorSwatchGroup from "./ui/ColorSwatchGroup.astro";
---

<div data-zone-editor>
  <div data-zone-editor-idle>
    <Button variant="primary" size="md" class="w-full" data-action="zone-start-placing">
      Ajouter une zone
      <VectorSquare size={20} aria-hidden="true" />
    </Button>
  </div>

  <div data-zone-editor-form hidden class="flex flex-col gap-5">
    <div class="flex items-center justify-between">
      <span data-zone-form-status aria-live="polite" class="font-mono text-xs tracking-wider text-fg-secondary uppercase"></span>
      <Button variant="ghost" size="sm" data-action="zone-cancel-or-deselect" aria-label="Fermer">
        ✕
      </Button>
    </div>

    <p data-zone-placing-hint hidden class="text-xs text-fg-secondary">
      Clic = ajouter un sommet · Double-clic ou Entrée = valider · Échap = annuler
    </p>

    <p data-zone-edit-hint hidden class="text-xs text-fg-secondary">
      Glisser un sommet pour le déplacer · Clic sur un point intermédiaire pour ajouter un sommet · Clic droit sur un sommet pour le supprimer
    </p>

    <fieldset class="flex flex-col gap-2">
      <FieldLabel as="legend">Couleur</FieldLabel>
      <ColorSwatchGroup fieldAttr="data-zone-field" fieldValue="color" groupLabel="Couleur de la zone" />
    </fieldset>

    <TextField
      id="zone-label"
      label="Label (optionnel)"
      placeholder="ALPHA"
      maxlength={40}
      data-zone-field="label"
    />

    <label class="flex cursor-pointer items-start gap-3 rounded-sm border border-line-default px-3 py-2 has-[:checked]:border-accent has-[:checked]:bg-surface-elevated has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-accent">
      <input
        type="checkbox"
        data-zone-field="play-area"
        class="mt-0.5 size-4 accent-[var(--color-accent)]"
      />
      <span class="flex flex-col gap-1">
        <span class="text-sm text-fg-primary">Zone de jeu</span>
        <span class="text-xs text-fg-secondary">Délimite le terrain jouable. Une seule zone de jeu par opération.</span>
      </span>
    </label>

    <Button variant="primary" size="md" class="w-full" data-action="zone-finish">
      Valider
    </Button>

    <div data-zone-delete-wrap hidden class="border-t border-line-subtle pt-4">
      <Button variant="ghost" size="sm" class="w-full text-danger hover:bg-surface-elevated" data-action="zone-delete">
        Supprimer cette zone
      </Button>
    </div>
  </div>
</div>

<script>
  import type { MarkerColor } from "../data/markers";
  import {
    deleteSelected,
    finishDraft,
    getState,
    selectZone,
    setMode,
    subscribe,
    updateDraft,
    updateSelected,
  } from "../lib/zones-store";

  const root = document.querySelector<HTMLElement>("[data-zone-editor]");
  if (root) {
    const idle = root.querySelector<HTMLElement>("[data-zone-editor-idle]")!;
    const form = root.querySelector<HTMLElement>("[data-zone-editor-form]")!;
    const statusEl = root.querySelector<HTMLElement>("[data-zone-form-status]")!;
    const placingHint = root.querySelector<HTMLElement>("[data-zone-placing-hint]")!;
    const editHint = root.querySelector<HTMLElement>("[data-zone-edit-hint]")!;
    const startBtn = root.querySelector<HTMLButtonElement>(
      'button[data-action="zone-start-placing"]',
    )!;
    const cancelBtn = root.querySelector<HTMLButtonElement>(
      'button[data-action="zone-cancel-or-deselect"]',
    )!;
    const finishBtn = root.querySelector<HTMLButtonElement>(
      'button[data-action="zone-finish"]',
    )!;
    const labelInput = root.querySelector<HTMLInputElement>(
      'input[data-zone-field="label"]',
    )!;
    const colorBtns = root.querySelectorAll<HTMLButtonElement>(
      'button[data-zone-field="color"]',
    );
    const playAreaCheckbox = root.querySelector<HTMLInputElement>(
      'input[data-zone-field="play-area"]',
    )!;
    const deleteWrap = root.querySelector<HTMLElement>("[data-zone-delete-wrap]")!;
    const deleteBtn = root.querySelector<HTMLButtonElement>(
      'button[data-action="zone-delete"]',
    )!;

    startBtn.addEventListener("click", () => setMode("placing"));

    function closeEditor(): void {
      const { mode, selectedId, draftPoints } = getState();
      if (mode === "placing") {
        // If user has placed >= 3 points and clicks "Valider", finalize.
        if (draftPoints.length >= 3) {
          finishDraft();
        } else {
          setMode("idle");
        }
      } else if (selectedId) {
        selectZone(null);
      }
    }

    cancelBtn.addEventListener("click", () => {
      const { mode } = getState();
      if (mode === "placing") setMode("idle");
      else selectZone(null);
    });
    finishBtn.addEventListener("click", closeEditor);

    for (const btn of colorBtns) {
      btn.addEventListener("click", () => {
        const value = btn.dataset.value as MarkerColor;
        const { selectedId } = getState();
        if (selectedId) updateSelected({ color: value });
        else updateDraft({ color: value });
      });
    }

    labelInput.addEventListener("input", () => {
      const { selectedId } = getState();
      if (selectedId) updateSelected({ label: labelInput.value });
      else updateDraft({ label: labelInput.value });
    });

    playAreaCheckbox.addEventListener("change", () => {
      const isPlayArea = playAreaCheckbox.checked;
      const { selectedId } = getState();
      if (selectedId) updateSelected({ isPlayArea });
      else updateDraft({ isPlayArea });
    });

    deleteBtn.addEventListener("click", () => {
      deleteSelected();
    });

    function render(): void {
      const state = getState();
      const showIdle = state.mode === "idle" && state.selectedId === null;
      idle.hidden = !showIdle;
      form.hidden = showIdle;
      deleteWrap.hidden = !state.selectedId;
      placingHint.hidden = state.mode !== "placing";
      editHint.hidden = state.selectedId === null;

      if (showIdle) return;

      const source = state.selectedId
        ? state.zones.find((z) => z.id === state.selectedId)
        : null;
      const data = source ?? state.draft;

      statusEl.textContent =
        state.mode === "placing"
          ? `Placement (${state.draftPoints.length} sommet${state.draftPoints.length > 1 ? "s" : ""})`
          : "Zone sélectionnée";

      cancelBtn.setAttribute(
        "aria-label",
        state.mode === "placing" ? "Annuler le placement" : "Désélectionner",
      );

      // Disable Valider if drafting and < 3 points
      finishBtn.disabled =
        state.mode === "placing" && state.draftPoints.length < 3;

      for (const btn of colorBtns) {
        btn.setAttribute("aria-checked", String(btn.dataset.value === data.color));
      }

      const labelValue = data.label ?? "";
      if (labelInput.value !== labelValue) {
        labelInput.value = labelValue;
      }

      if (playAreaCheckbox.checked !== data.isPlayArea) {
        playAreaCheckbox.checked = data.isPlayArea;
      }
    }

    render();
    subscribe(render);
  }
</script>
