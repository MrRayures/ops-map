---
import Plus from "@lucide/astro/icons/plus";
import Minus from "@lucide/astro/icons/minus";
import Maximize from "@lucide/astro/icons/maximize";
import Button from "../components/ui/Button.astro";
import Map from "../components/Map.astro";
import MarkerLayer from "../components/MarkerLayer.astro";
import ZoneLayer from "../components/ZoneLayer.astro";
import TextLayer from "../components/TextLayer.astro";
import PanelGroup from "../components/PanelGroup.astro";
import PrintOverlay from "../components/PrintOverlay.astro";
import Sidebar from "../components/Sidebar.astro";
import Toast from "../components/Toast.astro";
import "../styles/global.css";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>ops-map</title>
	</head>
	<body class="flex h-dvh overflow-hidden bg-surface-base text-fg-primary">
		<Sidebar />
		<PanelGroup />
		<main class="c-map__wrapper relative flex-1">
			<div class="c-map__ui">
				<div class="c-map__zoom-controls">
					<Button variant="secondary" size="sm" class="bg-black text-white hover:bg-neutral-800 hover:text-white" data-action="zoom-in" aria-label="Zoomer" title="Zoomer">
						<Plus size={16} aria-hidden="true" />
					</Button>
					<Button variant="secondary" size="sm" class="bg-black text-white hover:bg-neutral-800 hover:text-white" data-action="zoom-out" aria-label="Dézoomer" title="Dézoomer">
						<Minus size={16} aria-hidden="true" />
					</Button>
					<Button variant="secondary" size="sm" class="bg-black text-white hover:bg-neutral-800 hover:text-white" data-action="zoom-fit" aria-label="Recadrer sur la zone de jeu" title="Recadrer sur la zone de jeu">
						<Maximize size={16} aria-hidden="true" />
					</Button>
				</div>
			</div>
			<Map />
			<ZoneLayer />
			<TextLayer />
			<MarkerLayer />
		</main>
		<PrintOverlay />
		<Toast />
	</body>
</html>

<script>
  import { initApp } from "../lib/app-bootstrap";
  import { initSelectionCoordinator } from "../lib/selection-coordinator";
  import { initSettingsControls } from "../lib/settings-controls";
  import { initZoomControls } from "../lib/zoom-controls";
  import { initPrintControls } from "../lib/print-controls";
  import { initPersistenceControls } from "../lib/persistence-controls";
  import { createToast } from "../lib/toast";

  const boot = initApp();
  if (boot) {
    const showToast = createToast();

    initSettingsControls(boot.state.settings);
    initSelectionCoordinator();
    initZoomControls(showToast);
    initPrintControls({
      getTitle: () => boot.titleInput.value,
      getTerrain: () => boot.terrainInput.value,
    });
    initPersistenceControls({
      titleInput: boot.titleInput,
      terrainInput: boot.terrainInput,
      showToast,
      commitTitle: boot.commitTitle,
      commitTerrain: boot.commitTerrain,
      onStateApplied: boot.refreshPersistenceRefs,
    });
  }
</script>
