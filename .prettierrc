{
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "overrides": [
    {
      "files": ["*.astro"],
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": ["*.scss"],
      "options": {
        "tabWidth": 4
      }
    }
  ]
}
