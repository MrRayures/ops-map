{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "npx eslint --fix \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "npx tsc --noEmit 2>/dev/null | head -20 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$CLAUDE_FILE_PATH\" | grep -qE '\\.(env|pem|key)$|credentials|secrets' && echo 'BLOCK: Protected file' && exit 1 || exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$CLAUDE_TOOL_INPUT\" | grep -qE 'push.*(main|master)|commit.*--(amend|no-verify)' && echo 'BLOCK: Protected branch' && exit 1 || exit 0"
          }
        ]
      }
    ]
  },
  "deny": [
    "Bash(rm -rf *)",
    "Bash(git push --force*)",
    "Bash(git reset --hard*)",
    "Bash(git checkout -- .)",
    "Bash(git clean -fd*)",
    "Bash(chmod 777*)",
    "Bash(curl*|*sh)",
    "Bash(wget*|*sh)",
    "Bash(npm publish*)",
    "Bash(*DROP TABLE*)",
    "Bash(*DROP DATABASE*)",
    "Bash(*TRUNCATE*)",
    "Bash(*DELETE FROM*)",
    "Edit(file_path=.env*)",
    "Write(file_path=.env*)",
    "Edit(file_path=*credentials*)",
    "Write(file_path=*credentials*)",
    "Edit(file_path=*.pem)",
    "Write(file_path=*.pem)",
    "Edit(file_path=*.key)",
    "Write(file_path=*.key)",
    "Edit(file_path=*secret*)",
    "Write(file_path=*secret*)"
  ]
}
